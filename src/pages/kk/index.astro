---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Events from '../../components/Events.astro';
import BuiltWithCursorSummary from '../../components/BuiltWithCursorSummary.astro';
import Community from '../../components/Community.astro';
import About from '../../components/About.astro';
import Footer from '../../components/Footer.astro';
import { getDict } from '../../i18n/utils';

const locale = 'kk' as const;
const dict = getDict(locale);
---

<Base locale={locale} dict={dict}>
  <Header locale={locale} dict={dict} />
  <main>
    <Hero dict={dict} />
    <Events locale={locale} dict={dict} />
    <BuiltWithCursorSummary locale={locale} dict={dict} />
    <Community dict={dict} />
    <About dict={dict} />
  </main>
  <Footer locale={locale} dict={dict} />
</Base>
