---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import CodeOfConduct from '../components/CodeOfConduct.astro';
import Footer from '../components/Footer.astro';
import { conductPathsByLocale, getCodeOfConduct } from '../data/code-of-conduct/load';
import { getDict } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

const locale: Locale = 'ru';
const dict = getDict(locale);
const coc = getCodeOfConduct(locale);
---

<Base
  locale={locale}
  dict={dict}
  pageMeta={coc.meta}
  canonicalPath={conductPathsByLocale[locale]}
  hreflangPaths={conductPathsByLocale}
>
  <Header locale={locale} dict={dict} />
  <main>
    <CodeOfConduct coc={coc} />
  </main>
  <Footer locale={locale} dict={dict} />
</Base>
