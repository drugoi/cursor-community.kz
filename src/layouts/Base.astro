---
import '../styles/global.css';

import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  dict: any;
}

const { locale, dict } = Astro.props;

const siteUrl = 'https://cursor-community.kz';

const canonicalPaths: Record<Locale, string> = {
  ru: '/',
  kk: '/kk/',
  en: '/en/',
};

const canonicalUrl = `${siteUrl}${canonicalPaths[locale]}`;

const title = dict.meta.title;
const description = dict.meta.description;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalOrganization',
  name: 'Cursor Community Kazakhstan',
  url: siteUrl,
  description: 'Developer community in Kazakhstan for Cursor users',
  areaServed: {
    '@type': 'Country',
    name: 'Kazakhstan',
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'KZ',
  },
  sameAs: [
    'https://t.me/+IQDkySGNoCVkMTUy',
    'https://lu.ma/cursorcommunity',
    'https://forum.cursor.com',
  ],
};

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: 'Kazakhstan',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'KZ',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Cursor Community Kazakhstan',
  url: siteUrl,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <script is:inline>
      (function () {
        try {
          var k = 'cursor-community-theme';
          var stored = localStorage.getItem(k);
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.style.colorScheme = theme;
        } catch {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.style.colorScheme = 'dark';
        }
      })();
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Favicon (Cursor brand) -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="ru" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="kk" href={`${siteUrl}/kk/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content="Cursor Community Kazakhstan" />
    <meta property="og:image" content={`${siteUrl}/brand/lockup-horizontal-dark.png`} />
    <meta property="og:image:width" content="6717" />
    <meta property="og:image:height" content="1597" />
    <meta property="og:image:alt" content="Cursor Community Kazakhstan" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/brand/lockup-horizontal-dark.png`} />

    <!-- Geo meta -->
    <meta name="geo.region" content="KZ" />
    <meta name="geo.placename" content="Kazakhstan" />

    <!-- Structured data: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Structured data: Place -->
    <script type="application/ld+json" set:html={JSON.stringify(placeSchema)} />

    <!-- Structured data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <slot />
    <script>
      import { bindThemeToggle, initTheme } from '../scripts/theme';
      import '../scripts/console-easter-egg';

      initTheme();
      bindThemeToggle();
    </script>
  </body>
</html>
