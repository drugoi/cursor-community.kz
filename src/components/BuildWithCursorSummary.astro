---
import projectsData from '../data/buildwithcursor.json';

interface Project {
  id: string;
  title: string;
  description: string;
  url: string;
  image: string;
}

interface Props {
  locale: 'ru' | 'kk' | 'en';
  dict: {
    buildwithcursor: {
      heading: string;
      command: string;
      submit_cta: string;
      submit_description: string;
      no_projects: string;
      summary: string;
      projects_added: string;
      view_all_cta: string;
    };
  };
}

const { locale, dict } = Astro.props;
const projects = projectsData as Project[];
const projectsCount = projects.length;
const projectsPageHref = locale === 'ru' ? '/projects/' : `/${locale}/projects/`;
---

<section id="buildwithcursor" class="section">
  <div class="container">
    <p class="heading-command" aria-hidden="true">{dict.buildwithcursor.command}</p>
    <h2 class="heading-sub">{dict.buildwithcursor.heading}</h2>
    <div class="summary-card">
      <p class="summary-text">{dict.buildwithcursor.summary}</p>
      <p class="summary-count">
        <span class="summary-count-number">{projectsCount}</span>
        <span class="summary-count-label">{dict.buildwithcursor.projects_added}</span>
      </p>
      <div class="summary-actions">
        <a href={projectsPageHref} class="summary-link">{dict.buildwithcursor.view_all_cta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: var(--section-padding) 0;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .summary-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem 2rem;
  }

  .summary-text {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .summary-count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 1rem 0;
  }

  .summary-count-number {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--accent-brand);
  }

  .summary-count-label {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .summary-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-brand);
    border: 1px solid var(--accent-brand-dim);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .summary-link:hover {
    background: var(--accent-brand-glow);
    border-color: var(--accent-brand);
  }
</style>
