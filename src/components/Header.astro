---
interface Props {
  locale: 'ru' | 'kk' | 'en';
  dict: {
    nav: {
      events: string;
      builtwithcursor: string;
      community: string;
      about: string;
      theme_to_light: string;
      theme_to_dark: string;
    };
  };
}

const { locale, dict } = Astro.props;
const homeHref = locale === 'ru' ? '/' : `/${locale}/`;
const projectsHref = locale === 'ru' ? '/projects/' : `/${locale}/projects/`;

const langLinks = [
  { code: 'ru' as const, label: 'RU', href: '/' },
  { code: 'kk' as const, label: 'KK', href: '/kk/' },
  { code: 'en' as const, label: 'EN', href: '/en/' },
] as const;
---
<header class="header">
  <div class="header-inner container">
    <a href={homeHref} class="logo" aria-label="Cursor Community Kazakhstan">
      <svg
        class="logo-icon"
        width="24"
        height="24"
        viewBox="0 0 466.73 532.09"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M457.43,125.94L244.42,2.96c-6.84-3.95-15.28-3.95-22.12,0L9.3,125.94c-5.75,3.32-9.3,9.46-9.3,16.11v247.99c0,6.65,3.55,12.79,9.3,16.11l213.01,122.98c6.84,3.95,15.28,3.95,22.12,0l213.01-122.98c5.75-3.32,9.3-9.46,9.3-16.11v-247.99c0-6.65-3.55-12.79-9.3-16.11h-.01ZM444.05,151.99l-205.63,356.16c-1.39,2.4-5.06,1.42-5.06-1.36v-233.21c0-4.66-2.49-8.97-6.53-11.31L24.87,145.67c-2.4-1.39-1.42-5.06,1.36-5.06h411.26c5.84,0,9.49,6.33,6.57,11.39h-.01Z"
        ></path>
      </svg>
      <span class="logo-prompt">&gt;</span>
      <span class="logo-text">cursor_kz</span>
    </a>

    <nav class="nav">
      <a href={`${homeHref}#events`} class="nav-link">{dict.nav.events}</a>
      <a href={projectsHref} class="nav-link">{dict.nav.builtwithcursor}</a>
      <a href={`${homeHref}#community`} class="nav-link">{dict.nav.community}</a>
      <a href={`${homeHref}#about`} class="nav-link">{dict.nav.about}</a>
    </nav>

    <div class="header-trailing">
      <div class="lang-switcher">
        {langLinks.map(({ code, label, href }) => (
          <a
            href={href}
            class={`lang-link${locale === code ? ' lang-link--active' : ''}`}
            aria-current={locale === code ? 'page' : undefined}
          >
            <span class="lang-link__label">{label}</span>
          </a>
        ))}
      </div>

      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        data-label-light={dict.nav.theme_to_light}
        data-label-dark={dict.nav.theme_to_dark}
        aria-label={dict.nav.theme_to_dark}
      >
        <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"></circle>
            <path
              d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path
              d="M21 14.5A8.5 8.5 0 0 1 9.5 3a8.5 8.5 0 1 0 11.5 11.5Z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    background-color: var(--bg-header);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding-top: env(safe-area-inset-top, 0);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
    flex-wrap: wrap;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    color: inherit;
    gap: 0.5rem;
  }

  .logo-icon {
    flex-shrink: 0;
    display: block;
    width: 24px;
    height: 24px;
    color: var(--text-primary);
  }

  .logo-prompt {
    color: var(--accent-ink);
    margin-right: 0.25rem;
  }

  .logo-text {
    color: var(--text-primary);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s var(--ease-standard);
  }

  @media (max-width: 640px) {
    .nav-link {
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
    }
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .header-trailing {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .lang-link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s var(--ease-standard);
  }

  @media (max-width: 640px) {
    .lang-link {
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
      padding: 0 0.25rem;
    }
  }

  .lang-link:hover {
    color: var(--text-secondary);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-card);
    color: var(--text-primary);
    cursor: pointer;
    transition:
      color 0.2s var(--ease-standard),
      border-color 0.2s var(--ease-standard),
      background-color 0.2s var(--ease-standard);
  }

  .theme-toggle:hover {
    border-color: var(--border-hover);
    background: var(--bg-card-hover);
  }

  .theme-toggle__icon {
    display: none;
    line-height: 0;
  }

  .theme-toggle__icon svg {
    display: block;
  }

  :global([data-theme='light']) .theme-toggle__icon--moon {
    display: block;
  }

  :global([data-theme='dark']) .theme-toggle__icon--sun {
    display: block;
  }

  .lang-link--active {
    color: var(--text-primary);
    font-weight: 600;
  }

  .lang-link--active .lang-link__label {
    text-decoration: underline;
    text-decoration-color: var(--accent-brand);
    text-underline-offset: 0.2em;
  }

  .lang-link:not(:last-child)::after {
    content: ' | ';
    color: var(--text-muted);
    margin-left: 0.5rem;
    font-weight: 400;
  }

  .lang-link--active::after {
    color: var(--border);
  }

  @media (max-width: 640px) {
    .header {
      padding-top: 0;
    }

    .header-inner {
      gap: 1rem;
      padding-top: 0;
      padding-bottom: 0.75rem;
    }

    .logo {
      order: 1;
    }

    .header-trailing {
      order: 2;
      margin-left: auto;
    }

    .nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      gap: 1rem;
    }
  }
</style>
