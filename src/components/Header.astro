---
interface Props {
  locale: 'ru' | 'kk' | 'en';
  dict: {
    nav: {
      events: string;
      community: string;
      about: string;
    };
  };
}

const { locale, dict } = Astro.props;

const langLinks = [
  { code: 'ru' as const, label: 'RU', href: '/' },
  { code: 'kk' as const, label: 'KK', href: '/kk/' },
  { code: 'en' as const, label: 'EN', href: '/en/' },
] as const;
---
<header class="header">
  <div class="header-inner container">
    <a href={locale === "ru" ? "/" : `/${locale}/`} class="logo" aria-label="Cursor Community Kazakhstan">
      <img src="/brand/cube.svg" alt="" class="logo-icon" width="24" height="24" />
      <span class="logo-prompt">&gt;</span>
      <span class="logo-text">cursor_kz</span>
    </a>

    <nav class="nav">
      <a href="#events" class="nav-link">{dict.nav.events}</a>
      <a href="#community" class="nav-link">{dict.nav.community}</a>
      <a href="#about" class="nav-link">{dict.nav.about}</a>
    </nav>

    <div class="lang-switcher">
      {langLinks.map(({ code, label, href }) => (
        <a
          href={href}
          class={`lang-link${locale === code ? ' lang-link--active' : ''}`}
          aria-current={locale === code ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    background-color: var(--bg-header);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding-top: env(safe-area-inset-top, 0);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
    flex-wrap: wrap;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    color: inherit;
    gap: 0.5rem;
  }

  .logo-icon {
    flex-shrink: 0;
    display: block;
  }

  .logo-prompt {
    color: var(--accent-brand);
    margin-right: 0.25rem;
  }

  .logo-text {
    color: var(--text-primary);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (max-width: 640px) {
    .nav-link {
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
    }
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .lang-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (max-width: 640px) {
    .lang-link {
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
      padding: 0 0.25rem;
    }
  }

  .lang-link:hover {
    color: var(--text-secondary);
  }

  .lang-link--active {
    color: var(--accent-brand);
    font-weight: 500;
  }

  .lang-link:not(:last-child)::after {
    content: ' | ';
    color: var(--text-muted);
    margin-left: 0.5rem;
    font-weight: 400;
  }

  .lang-link--active::after {
    color: var(--border);
  }

  @media (max-width: 640px) {
    .header {
      padding-top: 0;
    }

    .header-inner {
      gap: 1rem;
      padding-top: 0;
      padding-bottom: 0.75rem;
    }

    .nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      gap: 1rem;
    }

    .lang-switcher {
      margin-left: auto;
    }
  }
</style>
