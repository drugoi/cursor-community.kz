---
interface Props {
  locale: 'ru' | 'kk' | 'en';
  dict: {
    nav: {
      events: string;
      builtwithcursor: string;
      community: string;
      about: string;
      theme_to_light: string;
      theme_to_dark: string;
    };
  };
}

const { locale, dict } = Astro.props;
const homeHref = locale === 'ru' ? '/' : `/${locale}/`;
const projectsHref = locale === 'ru' ? '/projects/' : `/${locale}/projects/`;

const langLinks = [
  { code: 'ru' as const, label: 'RU', href: '/' },
  { code: 'kk' as const, label: 'KK', href: '/kk/' },
  { code: 'en' as const, label: 'EN', href: '/en/' },
] as const;
---
<header class="header">
  <div class="header-inner container">
    <a href={homeHref} class="logo" aria-label="Cursor Community Kazakhstan">
      <img src="/brand/cube.svg" alt="" class="logo-icon" width="24" height="24" />
      <span class="logo-prompt">&gt;</span>
      <span class="logo-text">cursor_kz</span>
    </a>

    <nav class="nav">
      <a href={`${homeHref}#events`} class="nav-link">{dict.nav.events}</a>
      <a href={projectsHref} class="nav-link">{dict.nav.builtwithcursor}</a>
      <a href={`${homeHref}#community`} class="nav-link">{dict.nav.community}</a>
      <a href={`${homeHref}#about`} class="nav-link">{dict.nav.about}</a>
    </nav>

    <button
      type="button"
      class="theme-toggle"
      id="theme-toggle"
      data-label-light={dict.nav.theme_to_light}
      data-label-dark={dict.nav.theme_to_dark}
      aria-label={dict.nav.theme_to_dark}
    >
      <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm0-16a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1Zm0 20a1 1 0 0 1-1-1v-1a1 1 0 1 1 2 0v1a1 1 0 0 1-1 1ZM5.64 5.64a1 1 0 0 1 1.41 0l.71.71a1 1 0 0 1-1.41 1.41l-.71-.71a1 1 0 0 1 0-1.41Zm12.02 12.02a1 1 0 0 1-1.41 0l-.71-.71a1 1 0 1 1 1.41-1.41l.71.71a1 1 0 0 1 0 1.41ZM18 12a1 1 0 0 1-1 1h-1a1 1 0 1 1 0-2h1a1 1 0 0 1 1 1ZM8 12a1 1 0 0 1-1-1H6a1 1 0 0 1 0-2h1a1 1 0 0 1 1 1Zm9.36-6.36a1 1 0 0 1 0 1.41l-.71.71a1 1 0 1 1-1.41-1.41l.71-.71a1 1 0 0 1 1.41 0ZM6.34 17.66a1 1 0 0 1 0-1.41l.71-.71a1 1 0 1 1 1.41 1.41l-.71.71a1 1 0 0 1-1.41 0Z"
            fill="currentColor"></path>
        </svg>
      </span>
      <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M21 14.5A8.5 8.5 0 0 1 9.5 3a8.5 8.5 0 1 0 11.5 11.5Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </button>

    <div class="lang-switcher">
      {langLinks.map(({ code, label, href }) => (
        <a
          href={href}
          class={`lang-link${locale === code ? ' lang-link--active' : ''}`}
          aria-current={locale === code ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
    background-color: var(--bg-header);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding-top: env(safe-area-inset-top, 0);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
    flex-wrap: wrap;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    color: inherit;
    gap: 0.5rem;
  }

  .logo-icon {
    flex-shrink: 0;
    display: block;
  }

  .logo-prompt {
    color: var(--accent-brand);
    margin-right: 0.25rem;
  }

  .logo-text {
    color: var(--text-primary);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (max-width: 640px) {
    .nav-link {
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
    }
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .lang-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (max-width: 640px) {
    .lang-link {
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
      padding: 0 0.25rem;
    }
  }

  .lang-link:hover {
    color: var(--text-secondary);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--bg-card);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    background: var(--bg-card-hover);
  }

  .theme-toggle__icon {
    display: none;
    line-height: 0;
  }

  :global([data-theme='light']) .theme-toggle__icon--moon {
    display: block;
  }

  :global([data-theme='dark']) .theme-toggle__icon--sun {
    display: block;
  }

  .lang-link--active {
    color: var(--accent-brand);
    font-weight: 500;
  }

  .lang-link:not(:last-child)::after {
    content: ' | ';
    color: var(--text-muted);
    margin-left: 0.5rem;
    font-weight: 400;
  }

  .lang-link--active::after {
    color: var(--border);
  }

  @media (max-width: 640px) {
    .header {
      padding-top: 0;
    }

    .header-inner {
      gap: 1rem;
      padding-top: 0;
      padding-bottom: 0.75rem;
    }

    .nav {
      order: 3;
      width: 100%;
      justify-content: flex-start;
      gap: 1rem;
    }

    .lang-switcher {
      margin-left: auto;
    }
  }
</style>
