---
import { getShowcaseProjectsCount } from '../data/showcase-projects';
import { getProjectsAddedLabel, type ProjectsAddedForms } from '../i18n/plurals';

interface Props {
  locale: 'ru' | 'kk' | 'en';
  dict: {
    builtwithcursor: {
      heading: string;
      command: string;
      submit_cta: string;
      submit_description: string;
      no_projects: string;
      summary: string;
      projects_added: ProjectsAddedForms;
      view_all_cta: string;
    };
  };
}

const { locale, dict } = Astro.props;
const projectsCount = getShowcaseProjectsCount();
const projectsAddedLabel = getProjectsAddedLabel(projectsCount, locale, dict.builtwithcursor.projects_added);
const projectsPageHref = locale === 'ru' ? '/projects/' : `/${locale}/projects/`;
---

<section id="builtwithcursor" class="section">
  <div class="container">
    <div class="section-header">
      <p class="heading-command" aria-hidden="true">{dict.builtwithcursor.command}</p>
      <h2 class="section-title">{dict.builtwithcursor.heading}</h2>
    </div>
    <div class="summary-card">
      <div class="summary-left">
        <span class="summary-count">{projectsCount}</span>
        <p class="summary-text">{dict.builtwithcursor.summary}</p>
      </div>
      <a href={projectsPageHref} class="btn btn-primary">
        {dict.builtwithcursor.view_all_cta}
      </a>
    </div>
  </div>
</section>

<style>
  .section-header {
    margin-bottom: 2rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--text-primary);
    margin-top: 0.5rem;
  }

  .summary-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    flex-wrap: wrap;
  }

  .summary-left {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .summary-count {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent-brand);
    line-height: 1;
  }

  .summary-text {
    color: var(--text-secondary);
    max-width: 400px;
    line-height: 1.5;
    font-size: 0.9375rem;
  }

  @media (max-width: 600px) {
    .summary-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
    }

    .summary-count {
      font-size: 1.75rem;
    }
  }
</style>
