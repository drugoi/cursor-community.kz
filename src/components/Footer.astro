---
interface Props {
  dict: any;
}

const { dict } = Astro.props;

const socialLinks = [
  { label: "Telegram", href: "https://t.me/+IQDkySGNoCVkMTUy", icon: "✈️" },
  { label: "Luma", href: "https://lu.ma/cursorcommunity", icon: "📅" },
  { label: "Forum", href: "https://forum.cursor.com", icon: "💻" },
];
---
<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="social-links">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
          >
            {link.icon} {link.label}
          </a>
        ))}
      </div>
      <div class="signature">
        <span class="prompt">&gt;</span> cursor_kz<span class="cursor-blink"></span>
      </div>
      <p class="copyright">{dict.footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    padding-bottom: max(2rem, env(safe-area-inset-bottom, 0px));
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .social-link {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s var(--ease-standard);
  }

  @media (max-width: 640px) {
    .social-link {
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
      padding: 0 0.5rem;
    }
  }

  .social-link:hover {
    color: var(--text-primary);
  }

  .signature {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--text-primary);
  }

  .copyright {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin: 0;
  }
</style>
