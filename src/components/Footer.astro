---
import { localizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
  dict: any;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const conductHref = `${localizedPath('/conduct/', locale)}`;
---
<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-top">
        <div class="footer-brand">
          <span class="footer-logo-text">cursor_kz</span>
          <div class="signature">
            <span class="prompt">&gt;</span> made_with_<span class="heart">&lt;3</span><span class="cursor-blink"></span>
          </div>
        </div>
        <nav class="footer-nav">
          <a href={conductHref} class="footer-link">{dict.footer.code_of_conduct}</a>
        </nav>
      </div>

      <div class="footer-social">
        <a href="https://t.me/+IQDkySGNoCVkMTUy" target="_blank" rel="noopener noreferrer" class="social-link">Telegram</a>
        <a href="https://lu.ma/cursorcommunity" target="_blank" rel="noopener noreferrer" class="social-link">Luma</a>
        <a href="https://forum.cursor.com" target="_blank" rel="noopener noreferrer" class="social-link">Forum</a>
        <a href="https://discord.gg/cursor" target="_blank" rel="noopener noreferrer" class="social-link">Discord</a>
      </div>

      <p class="copyright">{dict.footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 0 2rem;
    margin-top: 4rem;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--container-max);
    padding: 0 var(--container-padding);
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .footer-logo-text {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .signature {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .heart {
    color: var(--accent-brand);
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-link:hover {
    color: var(--text-primary);
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .social-link {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: color 0.15s, border-color 0.15s;
  }

  .social-link:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 640px) {
    .footer-top {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .footer-nav {
      gap: 1rem;
    }
  }
</style>
