---
import { getCollection } from 'astro:content';

interface Props {
  locale: 'ru' | 'kk' | 'en';
  dict: {
    events: {
      heading: string;
      command: string;
      register: string;
      past: string;
      upcoming: string;
      past_heading: string;
      upcoming_heading: string;
      no_upcoming: string;
      no_upcoming_cta: string;
    };
  };
}

const { locale, dict } = Astro.props;
const allEvents = await getCollection('events');
const filtered = allEvents.filter((e) => e.data.lang === locale || e.data.lang === 'ru');
const upcomingEvents = filtered.filter((e) => e.data.status === 'upcoming').sort(() => 0);
const pastEvents = filtered
  .filter((e) => e.data.status === 'past')
  .sort((a, b) => (b.data.date < a.data.date ? -1 : b.data.date > a.data.date ? 1 : 0));
const hasUpcoming = upcomingEvents.length > 0;

const cityNameMap: Record<string, string> = { almaty: 'Алматы', astana: 'Астана' };

function formatEventDate(isoDate: string): string {
  if (isoDate === 'TBD') return isoDate;
  const [y, m, d] = isoDate.split('-');
  return d && m && y ? `${d}.${m}.${y}` : isoDate;
}

const eventsJsonLd = [...upcomingEvents, ...pastEvents].map((event) => {
  const jsonLd: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: event.data.title,
    description: event.data.description,
    location: {
      '@type': 'Place',
      name: event.data.location,
      address: { '@type': 'PostalAddress', addressLocality: cityNameMap[event.data.city] ?? event.data.city, addressCountry: 'KZ' },
    },
    organizer: { '@type': 'Organization', name: 'Cursor Community Kazakhstan', url: 'https://cursor-community.kz' },
    eventStatus: event.data.status === 'past' ? 'https://schema.org/EventCompleted' : 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  };
  if (event.data.date !== 'TBD') jsonLd.startDate = event.data.date;
  if (event.data.registrationUrl) {
    jsonLd.offers = { '@type': 'Offer', url: event.data.registrationUrl, price: '0', priceCurrency: 'KZT', availability: 'https://schema.org/InStock' };
  }
  return jsonLd;
});
---

<section id="events" class="section">
  <div class="container">
    <div class="section-header">
      <p class="heading-command" aria-hidden="true">{dict.events.command}</p>
      <h2 class="section-title">{dict.events.heading}</h2>
    </div>

    {!hasUpcoming && (
      <div class="empty-state">
        <span class="empty-state-mono">// next event: TBD</span>
        <p class="empty-state-message">{dict.events.no_upcoming}</p>
        <a href="https://t.me/+IQDkySGNoCVkMTUy" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          {dict.events.no_upcoming_cta}
        </a>
      </div>
    )}

    {upcomingEvents.length > 0 && (
      <>
        <h3 class="events-subheading">{dict.events.upcoming_heading}</h3>
        <div class="events-grid">
          {upcomingEvents.map((event) => (
            <article class="event-card">
              <div class="event-card-inner">
                <div class="event-meta">
                  <span class="event-badge event-badge--upcoming">{dict.events.upcoming}</span>
                  <span class="event-format">{event.data.format}</span>
                </div>
                <h3 class="event-title">{event.data.title}</h3>
                <p class="event-location">📍 {event.data.location}</p>
                <p class="event-date">{formatEventDate(event.data.date)}</p>
                {event.data.registrationUrl && (
                  <a href={event.data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary event-btn">
                    {dict.events.register}
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </>
    )}

    {pastEvents.length > 0 && (
      <>
        <h3 class="events-subheading events-subheading--past">{dict.events.past_heading}</h3>
        <div class="events-grid events-grid--past">
          {pastEvents.map((event) => (
            <article class="event-card event-card--past">
              <div class="event-card-inner">
                <div class="event-meta">
                  <span class="event-badge event-badge--past">{dict.events.past}</span>
                  <span class="event-format">{event.data.format}</span>
                </div>
                <h3 class="event-title">{event.data.title}</h3>
                <p class="event-location">📍 {event.data.location}</p>
                <p class="event-date">{formatEventDate(event.data.date)}</p>
              </div>
            </article>
          ))}
        </div>
      </>
    )}
  </div>

  {eventsJsonLd.map((jsonLd) => (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  ))}
</section>

<style>
  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--text-primary);
    margin-top: 0.5rem;
  }

  .empty-state {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .empty-state-mono {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-brand-dim);
  }

  .empty-state-message {
    color: var(--text-secondary);
    max-width: 320px;
  }

  .events-subheading {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .events-subheading--past {
    margin-top: 3rem;
    color: var(--text-muted);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .event-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .event-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-card-hover);
  }

  .event-card-inner {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .event-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .event-badge--upcoming {
    background: var(--accent-brand);
    color: #fff;
  }

  .event-badge--past {
    background: var(--bg-card-elevated);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .event-format {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .event-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-top: 0.25rem;
    line-height: 1.3;
  }

  .event-location,
  .event-date {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .event-btn {
    margin-top: 0.5rem;
    align-self: flex-start;
    padding: 0.45rem 1rem;
    font-size: 0.875rem;
  }

  .event-card--past {
    opacity: 0.65;
    border-style: dashed;
  }

  .event-card--past:hover {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .events-grid {
      grid-template-columns: 1fr;
    }

    .empty-state {
      padding: 2rem 1.5rem;
    }
  }
</style>
