---
import { getCollection } from 'astro:content';

interface Props {
  locale: 'ru' | 'kk' | 'en';
  dict: {
    events: {
      heading: string;
      command: string;
      register: string;
      past: string;
      upcoming: string;
      no_upcoming: string;
      no_upcoming_cta: string;
    };
  };
}

const { locale, dict } = Astro.props;
const allEvents = await getCollection('events');
const events = allEvents
  .filter((e) => e.data.lang === locale || e.data.lang === 'ru')
  .sort((a, b) => {
    if (a.data.status === 'upcoming' && b.data.status === 'past') return -1;
    if (a.data.status === 'past' && b.data.status === 'upcoming') return 1;
    return 0;
  });

const hasUpcoming = events.some((e) => e.data.status === 'upcoming');

const cityNameMap: Record<string, string> = {
  almaty: 'Алматы',
  astana: 'Астана',
};

const eventsJsonLd = events.map((event) => {
  const jsonLd: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: event.data.title,
    description: event.data.description,
    location: {
      '@type': 'Place',
      name: event.data.location,
      address: {
        '@type': 'PostalAddress',
        addressLocality: cityNameMap[event.data.city] ?? event.data.city,
        addressCountry: 'KZ',
      },
    },
    organizer: {
      '@type': 'Organization',
      name: 'Cursor Community Kazakhstan',
      url: 'https://cursor-community.kz',
    },
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  };

  if (event.data.date !== 'TBD') {
    jsonLd.startDate = event.data.date;
  }

  if (event.data.registrationUrl) {
    jsonLd.offers = {
      '@type': 'Offer',
      url: event.data.registrationUrl,
      price: '0',
      priceCurrency: 'KZT',
      availability: 'https://schema.org/InStock',
    };
  }

  return jsonLd;
});
---

<section id="events" class="section">
  <div class="container">
    <h2 class="heading-command">{dict.events.command}</h2>
    <p class="heading-sub">{dict.events.heading}</p>

    {!hasUpcoming && (
      <div class="empty-state">
        <p class="empty-state-mono">// next event: TBD</p>
        <p class="empty-state-message">{dict.events.no_upcoming}</p>
        <a
          href="https://t.me/+IQDkySGNoCVkMTUy"
          target="_blank"
          rel="noopener noreferrer"
          class="empty-state-cta"
        >
          {dict.events.no_upcoming_cta}
        </a>
      </div>
    )}

    <div class="events-grid">
      {events.map((event) => (
        <article
          class:list={['event-card', { 'event-card--past': event.data.status === 'past' }]}
        >
          <h3>{event.data.title}</h3>
          <p class="event-location">📍 {event.data.location}</p>
          <p class="event-date">{event.data.date}</p>
          <p class="event-format">{event.data.format}</p>

          {event.data.status === 'upcoming' && event.data.registrationUrl ? (
            <a
              href={event.data.registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-register"
            >
              {dict.events.register}
            </a>
          ) : event.data.status === 'past' ? (
            <span class="badge-past">{dict.events.past}</span>
          ) : null}
        </article>
      ))}
    </div>
  </div>

    {eventsJsonLd.map((jsonLd) => (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    ))}
</section>

<style>
  .section {
    padding: var(--section-padding) 0;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  h2:not(.heading-command) {
    font-family: var(--font-heading);
    margin-bottom: 2rem;
  }

  .no-upcoming {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .empty-state {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .empty-state-mono {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent-brand-dim);
    margin-bottom: 1rem;
  }

  .empty-state-message {
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .empty-state-cta {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent-brand);
    border: 1px solid var(--accent-brand-dim);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .empty-state-cta:hover {
    background: var(--accent-brand-glow);
    border-color: var(--accent-brand);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .event-card {
    background: var(--bg-card);
    border-radius: 12px;
    border: 1px solid var(--border);
    padding: 1.5rem;
    transition: all 0.2s ease;
  }

  .event-card:hover {
    border-color: var(--accent-brand-dim);
    background: var(--bg-card-hover);
    box-shadow: 0 0 20px var(--accent-brand-glow);
  }

  .event-card--past {
    opacity: 0.6;
  }

  .event-card--past:hover {
    opacity: 0.75;
  }

  .event-card h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .event-location {
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .event-date {
    font-family: var(--font-mono);
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .event-format {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .btn-register {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-brand);
    border: 1px solid var(--accent-brand-dim);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .btn-register:hover {
    background: var(--accent-brand-glow);
    border-color: var(--accent-brand);
  }

  .badge-past {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-brand-dim);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: var(--accent-brand-glow);
  }
</style>
