---
interface Props {
  dict: {
    hero: {
      title: string;
      subtitle: string;
      typewriter: string[];
      cta_join: string;
      cta_events: string;
    };
  };
}

const { dict } = Astro.props;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-content">
    <h1 class="hero-title">{dict.hero.title}</h1>
    <p class="hero-subtitle">{dict.hero.subtitle}</p>
    <div class="hero-typewriter">
      <span class="prompt">&gt;&nbsp;</span><span id="typewriter" data-phrases={JSON.stringify(dict.hero.typewriter)}></span><span class="cursor-blink"></span>
    </div>
    <div class="hero-ctas">
      <a
        href="https://t.me/+IQDkySGNoCVkMTUy"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        {dict.hero.cta_join}
      </a>
      <a href="#events" class="btn btn-secondary">
        {dict.hero.cta_events}
      </a>
    </div>
  </div>
</section>

<script>
  const el = document.getElementById('typewriter');
  if (el) {
    const phrases = JSON.parse(el.dataset.phrases || '[]');
    let current = 0;
    let charIdx = 0;
    let isDeleting = false;

    function tick() {
      const text = phrases[current] || '';

      if (!isDeleting) {
        el.textContent = text.slice(0, charIdx + 1);
        charIdx++;
        if (charIdx >= text.length) {
          isDeleting = true;
          setTimeout(tick, 2000);
          return;
        }
        setTimeout(tick, 80);
      } else {
        el.textContent = text.slice(0, charIdx - 1);
        charIdx--;
        if (charIdx <= 0) {
          isDeleting = false;
          if (phrases.length > 1) {
            let next;
            do {
              next = Math.floor(Math.random() * phrases.length);
            } while (next === current);
            current = next;
          } else {
            current = 0;
          }
          setTimeout(tick, 400);
          return;
        }
        setTimeout(tick, 40);
      }
    }

    if (phrases.length) tick();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(100vh, 100dvh);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 80px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 6rem;
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 50%, var(--hero-mesh-a) 0%, transparent 52%),
      radial-gradient(ellipse at 80% 20%, var(--hero-mesh-b) 0%, transparent 48%),
      var(--bg-primary);
    animation: gradient-mesh 12s ease-in-out infinite;
  }

  @keyframes gradient-mesh {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg {
      animation: none;
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: var(--container-max);
    padding: 0 var(--container-padding);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
  }

  .hero-typewriter {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-primary);
    margin: 0 auto 2rem;
    min-height: 1.5em;
    max-width: 500px;
    text-align: left;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      background-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out),
      transform 0.2s var(--ease-out),
      filter 0.2s var(--ease-out);
    cursor: pointer;
  }

  .btn-primary {
    background-color: var(--accent-brand-strong);
    color: var(--accent-on-accent);
    border: 2px solid var(--accent-brand-strong);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--accent-brand-strong) 40%, transparent);
  }

  .btn-primary:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent-brand-strong) 40%, transparent);
  }

  .btn-primary:active {
    transform: translateY(0);
    filter: brightness(0.98);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--accent-ink);
    border: 2px solid var(--accent-brand);
  }

  .btn-secondary:hover {
    background-color: var(--accent-brand);
    color: var(--accent-on-accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-card);
  }

  .btn-secondary:active {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover,
    .btn:active {
      transform: none;
    }
  }
</style>
