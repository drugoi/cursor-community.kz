---
interface Props {
  dict: {
    hero: {
      title: string;
      subtitle: string;
      typewriter: string[];
      cta_join: string;
      cta_events: string;
    };
  };
}

const { dict } = Astro.props;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-content">
    <h1 class="hero-title">{dict.hero.title}</h1>
    <p class="hero-subtitle">{dict.hero.subtitle}</p>
    <div class="hero-typewriter">
      <span class="prompt">&gt;&nbsp;</span><span id="typewriter" data-phrases={JSON.stringify(dict.hero.typewriter)}></span><span class="cursor-blink"></span>
    </div>
    <div class="hero-ctas">
      <a
        href="https://t.me/+IQDkySGNoCVkMTUy"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        {dict.hero.cta_join}
      </a>
      <a href="#events" class="btn btn-secondary">
        {dict.hero.cta_events}
      </a>
    </div>
  </div>
</section>

<script>
  const el = document.getElementById('typewriter');
  if (el) {
    const phrases = JSON.parse(el.dataset.phrases || '[]');
    let current = 0;
    let charIdx = 0;
    let isDeleting = false;

    function tick() {
      const text = phrases[current] || '';

      if (!isDeleting) {
        el.textContent = text.slice(0, charIdx + 1);
        charIdx++;
        if (charIdx >= text.length) {
          isDeleting = true;
          setTimeout(tick, 2000);
          return;
        }
        setTimeout(tick, 80);
      } else {
        el.textContent = text.slice(0, charIdx - 1);
        charIdx--;
        if (charIdx <= 0) {
          isDeleting = false;
          current = (current + 1) % phrases.length;
          setTimeout(tick, 400);
          return;
        }
        setTimeout(tick, 40);
      }
    }

    if (phrases.length) tick();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 80px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 6rem;
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(237, 236, 236, 0.05) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 20%, rgba(237, 236, 236, 0.03) 0%, transparent 50%),
      var(--bg-primary);
    animation: gradient-mesh 12s ease-in-out infinite;
  }

  @keyframes gradient-mesh {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.05);
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: var(--container-max);
    padding: 0 var(--container-padding);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
  }

  .hero-typewriter {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    margin: 0 auto 2rem;
    min-height: 1.5em;
    max-width: 500px;
    text-align: left;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-primary {
    background-color: var(--accent-brand);
    color: var(--bg-primary);
    border: 2px solid var(--accent-brand);
  }

  .btn-primary:hover {
    filter: brightness(1.1);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--accent-brand);
    border: 2px solid var(--accent-brand);
  }

  .btn-secondary:hover {
    background-color: var(--accent-brand);
    color: var(--bg-primary);
  }
</style>
