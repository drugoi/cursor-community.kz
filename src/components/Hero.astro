---
interface Props {
  dict: {
    hero: {
      title: string;
      subtitle: string;
      typewriter: string[];
      cta_join: string;
      cta_events: string;
    };
  };
}

const { dict } = Astro.props;
---

<section class="hero">
  <!-- Ambient background glow -->
  <div class="hero-bg-glow" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-layout">
    <div class="hero-content">
      <!-- Gradient title -->
      <h1 class="hero-title">
        <span class="title-cursor">Cursor</span> Community Kazakhstan
      </h1>

      <!-- Muted subtitle -->
      <p class="hero-subtitle">{dict.hero.subtitle}</p>

      <!-- Terminal input block -->
      <div class="hero-terminal" aria-label="Terminal input">
        <span class="terminal-prompt">&gt;</span>
        <span
          id="typewriter"
          class="terminal-text"
          data-phrases={JSON.stringify(dict.hero.typewriter)}></span>
        <span class="terminal-cursor" aria-hidden="true"></span>
      </div>

      <!-- CTA buttons -->
      <div class="hero-ctas">
        <a
          href="https://t.me/+IQDkySGNoCVkMTUy"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-glow"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M12 5v14M5 12h14"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          {dict.hero.cta_join}
        </a>
        <a href="#events" class="btn btn-ghost">
          {dict.hero.cta_events}
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M19 9l-7 7-7-7"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const el = document.getElementById("typewriter");
  if (el) {
    const phrases = JSON.parse(el.dataset.phrases || "[]");
    let current = 0,
      charIdx = 0,
      isDeleting = false;
    function tick() {
      const text = phrases[current] || "";
      if (!isDeleting) {
        el.textContent = text.slice(0, charIdx + 1);
        charIdx++;
        if (charIdx >= text.length) {
          isDeleting = true;
          setTimeout(tick, 2000);
          return;
        }
        setTimeout(tick, 80);
      } else {
        el.textContent = text.slice(0, charIdx - 1);
        charIdx--;
        if (charIdx <= 0) {
          isDeleting = false;
          if (phrases.length > 1) {
            let next;
            do {
              next = Math.floor(Math.random() * phrases.length);
            } while (next === current);
            current = next;
          } else {
            current = 0;
          }
          setTimeout(tick, 400);
          return;
        }
        setTimeout(tick, 40);
      }
    }
    if (phrases.length) tick();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem var(--container-padding) 5rem;
    overflow: hidden;
  }

  /* ── Background ── */
  .hero-bg-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 80% 60% at 70% 40%,
        rgba(245, 78, 0, 0.06) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 60% 50% at 20% 80%,
        rgba(245, 78, 0, 0.04) 0%,
        transparent 50%
      );
    pointer-events: none;
    z-index: 0;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(
      ellipse 80% 70% at 50% 50%,
      black 30%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 70% at 50% 50%,
      black 30%,
      transparent 80%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* ── Layout ── */
  .hero-layout {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .hero-content {
    max-width: 640px;
    text-align: center;
  }

  /* ── Title with gradient ── */
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    line-height: 1.05;
    letter-spacing: 0.01em;
    animation: fadeSlideUp 0.8s var(--ease-out) both;
    text-align: center;
  }

  /* ── Subtitle ── */
  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto 2rem;
    line-height: 1.7;
    font-weight: 400;
    animation: fadeSlideUp 0.8s var(--ease-out) 0.1s both;
  }

  /* ── Terminal block ── */
  .hero-terminal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 22px;
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 1.5vw, 0.95rem);
    color: var(--text-secondary);
    padding: 0.75rem 1rem;
    margin: 0 auto 2.5rem;
    max-width: fit-content;
    animation: fadeSlideUp 0.8s var(--ease-out) 0.2s both;
    position: relative;
    overflow: hidden;
  }

  .terminal-prompt {
    font-family: var(--font-mono);
    color: var(--accent-brand);
    opacity: 0.8;
    margin-right: 0.25rem;
  }

  .terminal-text {
    color: var(--text-primary);
    position: relative;
    z-index: 1;
    min-height: 1.1em;
  }

  .terminal-cursor {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    background-color: var(--accent-brand);
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
    border-radius: 1px;
    position: relative;
    z-index: 1;
  }

  /* ── CTA Buttons ── */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    animation: fadeSlideUp 0.8s var(--ease-out) 0.3s both;
  }

  .btn-glow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    background: var(--accent-brand);
    color: #ffffff;
    border: 1px solid var(--accent-brand);
    transition: all 0.2s var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .btn-glow::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.15) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.2s;
  }

  .btn-glow:hover {
    background: var(--accent-brand-strong);
    border-color: var(--accent-brand-strong);
    transform: translateY(-2px);
    box-shadow:
      0 0 20px rgba(245, 78, 0, 0.3),
      0 0 40px rgba(245, 78, 0, 0.15),
      0 4px 12px rgba(0, 0, 0, 0.3);
  }

  .btn-glow:hover::before {
    opacity: 1;
  }

  .btn-glow:active {
    transform: translateY(0);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.2s var(--ease-out);
  }

  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
  }

  .btn-ghost:active {
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .hero {
      padding: 7rem 1.25rem 4rem;
    }

    .hero-ctas {
      flex-direction: column;
      width: 100%;
    }

    .btn-glow,
    .btn-ghost {
      justify-content: center;
      width: 100%;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-subtitle,
    .hero-terminal,
    .hero-ctas {
      animation: none;
      opacity: 1;
    }

    .terminal-cursor {
      animation: none;
    }

    .btn-glow:hover,
    .btn-ghost:hover {
      transform: none;
    }
  }
</style>
