---
interface Props {
  dict: any;
}

const { dict } = Astro.props;

const links = [
  { href: "https://t.me/+IQDkySGNoCVkMTUy", name: "Telegram", emoji: "✈", descKey: "telegram_desc" },
  { href: "https://lu.ma/cursorcommunity", name: "Luma", emoji: "◈", descKey: "luma_desc" },
  { href: "https://forum.cursor.com", name: "Cursor Forum", emoji: "⤷", descKey: "forum_desc" },
  { href: "https://discord.gg/cursor", name: "Discord", emoji: "◈", descKey: "discord_desc" },
];
---

<section id="community" class="section">
  <div class="container">
    <div class="section-header">
      <p class="heading-command" aria-hidden="true">{dict.community.command}</p>
      <h2 class="section-title">{dict.community.heading}</h2>
    </div>
    <div class="community-grid">
      {links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="community-card">
          <div class="card-body">
            <h3>{link.name}</h3>
            <p>{dict.community[link.descKey]}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--text-primary);
    margin-top: 0.5rem;
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .community-card {
    display: flex;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }

  .community-card:hover {
    border-color: var(--accent-brand);
    background: var(--bg-card-hover);
  }

  .card-body h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
    font-weight: 600;
  }

  .card-body p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    .community-card {
      padding: 1rem 1.25rem;
    }
  }
</style>
